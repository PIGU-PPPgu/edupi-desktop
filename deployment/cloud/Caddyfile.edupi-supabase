edupi.intelliclass.online {
	@preflight {
		method OPTIONS
		header_regexp Origin ^(https://edupi\.intelliclass\.online|capacitor://localhost|http://localhost(:[0-9]+)?)$
	}

	route {
		handle @preflight {
			header {
				Access-Control-Allow-Origin "https://edupi.intelliclass.online"
				Access-Control-Allow-Methods "GET, POST, PUT, PATCH, DELETE, OPTIONS"
				Access-Control-Allow-Headers "Authorization, apikey, content-type, x-client-info, x-edupi-workspace-id, idempotency-key, prefer"
				Access-Control-Max-Age "600"
				Vary "Origin"
			}
			respond 204
		}

		handle {
			header {
				Access-Control-Allow-Origin "https://edupi.intelliclass.online"
				Access-Control-Allow-Methods "GET, POST, PUT, PATCH, DELETE, OPTIONS"
				Access-Control-Allow-Headers "Authorization, apikey, content-type, x-client-info, x-edupi-workspace-id, idempotency-key, prefer"
				Access-Control-Max-Age "600"
				Vary "Origin"
			}
			reverse_proxy 127.0.0.1:55321 {
				header_down -Access-Control-Allow-Origin
				header_down -Access-Control-Allow-Credentials
				header_down -Access-Control-Allow-Methods
				header_down -Access-Control-Allow-Headers
				header_down -Access-Control-Max-Age
				header_down -Access-Control-Expose-Headers
				header_down -Vary
				header_down Access-Control-Allow-Origin "https://edupi.intelliclass.online"
				header_down Access-Control-Allow-Methods "GET, POST, PUT, PATCH, DELETE, OPTIONS"
				header_down Access-Control-Allow-Headers "Authorization, apikey, content-type, x-client-info, x-edupi-workspace-id, idempotency-key, prefer"
				header_down Access-Control-Max-Age "600"
				header_down Vary "Origin"
			}
		}
	}
}
