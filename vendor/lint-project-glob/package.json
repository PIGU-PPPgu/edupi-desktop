{
  "name": "@edupi/lint-project-glob",
  "version": "1.0.0",
  "private": true,
  "description": "Synchronous project discovery for EduPi's two pinned TypeScript ESLint consumers",
  "license": "MIT",
  "type": "module",
  "main": "./index.cjs",
  "exports": {
    ".": {
      "import": "./index.mjs",
      "require": "./index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "index.cjs",
    "index.mjs",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "glob": "14.0.6"
  }
}
